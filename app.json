{
  "expo": {
    "name": "Splitty",
    "slug": "Splitty",
    "scheme": "splitty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manjunath.splitty.app",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Splitty requires camera access so you can easily scan or capture photos of your receipts.",
        "NSPhotoLibraryUsageDescription": "Splitty requires photo library access so you can attach existing receipts or bills to your expenses.",
        "NSContactsUsageDescription": "Splitty requires contacts access so you can quickly add and select friends to split expenses with."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.splitty.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-notifications",
      "expo-contacts"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6ad47fd-4076-47a4-be0f-62c02c52fa33"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d6ad47fd-4076-47a4-be0f-62c02c52fa33"
    }
  }
}